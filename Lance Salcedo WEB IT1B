<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>University of Batangas - Core Values and Attributes</title>

    <style>

        * {
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background-color: #f5f5f5;
            color: #222;
        }

        /* =========================
           HEADER
        ========================== */

        header {
            background-color: #800000;
            color: white;
            text-align: center;
            padding: 60px 20px;
        }

        header h1 {
            margin: 0;
            font-size: 45px;
            letter-spacing: 1px;
        }

        header h2 {
            margin: 10px 0;
            font-size: 25px;
            font-weight: normal;
        }

        header p {
            margin: 5px 0;
            font-size: 18px;
        }


        /* =========================
           NAVIGATION
        ========================== */

        nav {
            background-color: #5c0000;
            padding: 15px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
            font-size: 15px;
            font-weight: bold;
        }

        nav a:hover {
            text-decoration: underline;
        }


        /* =========================
           INTRODUCTION
        ========================== */

        .intro {
            max-width: 950px;
            margin: 35px auto;
            padding: 35px;
            background-color: white;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.10);
        }

        .intro h2 {
            color: #800000;
            font-size: 30px;
            margin-top: 0;
        }

        .intro p {
            font-size: 17px;
            line-height: 1.7;
            color: #555;
        }


        /* =========================
           SECTIONS
        ========================== */

        .section {
            max-width: 1100px;
            margin: 30px auto;
            padding: 30px;
            background-color: white;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.10);
        }

        .section h2 {
            color: #800000;
            font-size: 25px;
            margin-top: 0;
            border-left: 6px solid #800000;
            padding-left: 12px;
        }

        .description {
            color: #555;
            font-size: 16px;
            line-height: 1.7;
        }


        /* =========================
           PICTURES
        ========================== */

        .pictures {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 15px;
            margin-top: 25px;
        }

        .pictures img {
            width: 100%;
            height: 170px;
            object-fit: cover;
            border-radius: 10px;
            background-color: #ddd;
            transition: 0.3s;
        }

        .pictures img:hover {
            transform: scale(1.04);
        }


        /* =========================
           FOOTER
        ========================== */

        footer {
            margin-top: 50px;
            background-color: #800000;
            color: white;
            text-align: center;
            padding: 30px;
        }

        footer p {
            margin: 5px;
        }


        /* =========================
           MOBILE DESIGN
        ========================== */

        @media (max-width: 800px) {

            header h1 {
                font-size: 32px;
            }

            header h2 {
                font-size: 20px;
            }

            nav {
                padding: 12px 5px;
            }

            nav a {
                display: inline-block;
                margin: 5px;
                font-size: 13px;
            }

            .section {
                margin: 20px 12px;
                padding: 20px;
            }

            .intro {
                margin: 20px 12px;
                padding: 25px;
            }

            .pictures {
                grid-template-columns: repeat(2, 1fr);
            }

            .pictures img {
                height: 140px;
            }
        }

    </style>
</head>


<body>


    <!-- =========================
         HEADER
    ========================== -->

    <header>

        <h1>University of Batangas</h1>

        <h2>Lipa City Campus</h2>

        <p>Core Values and Attributes</p>

    </header>


    <!-- =========================
         NAVIGATION
    ========================== -->

    <nav>

        <a href="#faith">Faith</a>

        <a href="#wisdom">Wisdom</a>

        <a href="#service">Service</a>

        <a href="#builder">Builder</a>

        <a href="#communication">Communicator</a>

        <a href="#global">Global Citizen</a>

        <a href="#learner">Lifelong Learner</a>

    </nav>


    <!-- =========================
         CORE VALUES INTRO
    ========================== -->

    <div class="intro">

        <h2>UB Core Values</h2>

        <p>
            The University of Batangas promotes values that guide
            students in their academic, personal, and social development.
            These values help students become responsible and meaningful
            members of society.
        </p>

    </div>


    <!-- =========================
         1. FAITH IN GOD
    ========================== -->

    <div class="section" id="faith">

        <h2>1. Faith in God (Spirit)</h2>

        <p class="description">

            Faith in God represents spirituality, trust, and
            devotion. It encourages students to strengthen their
            relationship with God and live according to good values.

        </p>


        <div class="pictures">

            <img src="images/faith1.jpg" alt="Faith in God">

            <img src="images/faith2.jpg" alt="Faith in God">

            <img src="images/faith3.jpg" alt="Faith in God">

            <img src="images/faith4.jpg" alt="Faith in God">

            <img src="images/faith5.jpg" alt="Faith in God">

        </div>

    </div>


    <!-- =========================
         2. LOVE OF WISDOM
    ========================== -->

    <div class="section" id="wisdom">

        <h2>2. Love of Wisdom (Intellect)</h2>

        <p class="description">

            Love of Wisdom represents the desire to learn,
            understand new ideas, develop knowledge, and
            continuously improve one's intellectual abilities.

        </p>


        <div class="pictures">

            <img src="images/wisdom1.jpg" alt="Love of Wisdom">

            <img src="images/wisdom2.jpg" alt="Love of Wisdom">

            <img src="images/wisdom3.jpg" alt="Love of Wisdom">

            <img src="images/wisdom4.jpg" alt="Love of Wisdom">

            <img src="images/wisdom5.jpg" alt="Love of Wisdom">

        </div>

    </div>


    <!-- =========================
         3. SERVICE TO FELLOWMEN
    ========================== -->

    <div class="section" id="service">

        <h2>3. Service to Fellowmen (Purpose)</h2>

        <p class="description">

            Service to Fellowmen encourages students to help
            others, contribute to their community, and use
            their abilities to make a positive difference.

        </p>


        <div class="pictures">

            <img src="images/service1.jpg" alt="Service to Fellowmen">

            <img src="images/service2.jpg" alt="Service to Fellowmen">

            <img src="images/service3.jpg" alt="Service to Fellowmen">

            <img src="images/service4.jpg" alt="Service to Fellowmen">

            <img src="images/service5.jpg" alt="Service to Fellowmen">

        </div>

    </div>


    <!-- =========================
         BEST ATTRIBUTES INTRO
    ========================== -->

    <div class="intro">

        <h2>UB Attributes - BEST</h2>

        <p>

            The University of Batangas aims to develop students
            who demonstrate knowledge, professionalism,
            responsibility, communication skills, and continuous
            personal growth.

        </p>

    </div>


    <!-- =========================
         4. BUILDER
    ========================== -->

    <div class="section" id="builder">

        <h2>4. Builder and Innovator of Knowledge</h2>

        <p class="description">

            This attribute represents creativity, innovation,
            research, and the ability to develop new ideas
            and knowledge.

        </p>


        <div class="pictures">

            <img src="images/builder1.jpg" alt="Builder and Innovator">

            <img src="images/builder2.jpg" alt="Builder and Innovator">

            <img src="images/builder3.jpg" alt="Builder and Innovator">

            <img src="images/builder4.jpg" alt="Builder and Innovator">

            <img src="images/builder5.jpg" alt="Builder and Innovator">

        </div>

    </div>


    <!-- =========================
         5. COMMUNICATOR
    ========================== -->

    <div class="section" id="communication">

        <h2>
            5. Efficient Professional and Effective Communicator
        </h2>

        <p class="description">

            This attribute focuses on professionalism,
            responsibility, confidence, and the ability to
            communicate ideas clearly and effectively.

        </p>


        <div class="pictures">

            <img src="images/communication1.jpg" alt="Effective Communicator">

            <img src="images/communication2.jpg" alt="Effective Communicator">

            <img src="images/communication3.jpg" alt="Effective Communicator">

            <img src="images/communication4.jpg" alt="Effective Communicator">

            <img src="images/communication5.jpg" alt="Effective Communicator">

        </div>

    </div>


    <!-- =========================
         6. GLOBAL-MINDED CITIZEN
    ========================== -->

    <div class="section" id="global">

        <h2>
            6. Social, Moral and Global-Minded Citizen
        </h2>

        <p class="description">

            This attribute encourages students to become
            responsible members of society who respect others,
            understand global issues, and contribute positively
            to their community.

        </p>


        <div class="pictures">

            <img src="images/global1.jpg" alt="Global-Minded Citizen">

            <img src="images/global2.jpg" alt="Global-Minded Citizen">

            <img src="images/global3.jpg" alt="Global-Minded Citizen">

            <img src="images/global4.jpg" alt="Global-Minded Citizen">

            <img src="images/global5.jpg" alt="Global-Minded Citizen">

        </div>

    </div>


    <!-- =========================
         7. LIFELONG LEARNER
    ========================== -->

    <div class="section" id="learner">

        <h2>
            7. Transformed Lifelong Learner
        </h2>

        <p class="description">

            This attribute represents continuous learning,
            personal growth, adaptability, and the willingness
            to develop new knowledge and skills throughout life.

        </p>


        <div class="pictures">

            <img src="images/learner1.jpg" alt="Lifelong Learner">

            <img src="images/learner2.jpg" alt="Lifelong Learner">

            <img src="images/learner3.jpg" alt="Lifelong Learner">

            <img src="images/learner4.jpg" alt="Lifelong Learner">

            <img src="images/learner5.jpg" alt="Lifelong Learner">

        </div>

    </div>


    <!-- =========================
         FOOTER
    ========================== -->

    <footer>

        <p>
            University of Batangas - Lipa City Campus
        </p>

        <p>
            Core Values and Attributes
        </p>

    </footer>


</body>
</html>
